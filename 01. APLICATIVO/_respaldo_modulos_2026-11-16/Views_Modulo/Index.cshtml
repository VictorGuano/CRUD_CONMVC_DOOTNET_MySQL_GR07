@* Módulo del SIGH al que el perfil tiene permiso; su funcionalidad se desarrolla en otros talleres *@
@model Opcion

<section class="encabezado-pagina">
    <div>
        <div class="antetitulo">@Model.Sistema.DescripcionSistema</div>
        <h1>@Model.DescripcionOpcion</h1>
        <p>Opción @Model.CodigoOpcion · ruta @Model.UrlOpcion</p>
    </div>
</section>

<div class="panel text-center py-5">
    <span class="modulo d-inline-flex border-0 p-0 mb-3" style="box-shadow:none">
        <span class="icono" style="width:64px;height:64px;font-size:30px"><i class="bi bi-tools"></i></span>
    </span>
    <h2>Acceso autorizado</h2>
    <p class="text-suave mx-auto" style="max-width:560px">
        Su perfil tiene la opción <strong>@Model.CodigoOpcion</strong> asignada, por eso puede entrar a este módulo.
        Las pantallas de @Model.Sistema.DescripcionSistema se implementarán en los siguientes talleres del SIGH.
    </p>
    <a class="btn btn-sigh mt-2" href="~/inicio"><i class="bi bi-house-door mr-1"></i> Volver al inicio</a>
</div>
